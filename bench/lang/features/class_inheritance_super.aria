// 量继承与 super:每轮一次派生方法调用,方法体内再 super 调被遮蔽的父实现。
var iterations = 4000000;  // 规模

def Base {
    init(v) {
        this.v = v;
    }
    describe() {
        return 1;
    }
}

def Derived : Base {
    init(v) {
        super.init(v);
    }
    describe() {
        return 10 + super.describe();
    }
}

var obj = Derived(7);

var t0 = clock();
var acc = 0;
var i = 0;
while (i < iterations) {
    acc = (acc + obj.describe()) % 1000003;
    i += 1;
}
var dt = clock() - t0;

assert(acc == 999871);
println("value checksum: " + str(acc));
println("bench-time: " + str(dt * 1000.0) + " ms");
