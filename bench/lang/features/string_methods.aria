// 量 string 方法面:每轮 trim/split/join/upper/starts_with/ends_with/find/replace/substring 各一次。
var rounds = 450000;  // 规模

var base = "  the quick brown fox jumps over the lazy dog  ";

var t0 = clock();
var acc = 0;
var i = 0;
while (i < rounds) {
    var t = base.trim();
    var parts = t.split(" ");
    var joined = parts.join("-");
    var up = t.upper();
    if (t.starts_with("the") && t.ends_with("dog")) {
        acc = acc + 1;
    }
    acc = (acc + t.find("fox") + t.replace("o", "0").size() + joined.size() + up.size() +
           t.substring(4, 9).size()) % 1000003;
    i += 1;
}
var dt = clock() - t0;

assert(acc == 949799);
println("value checksum: " + str(acc));
println("bench-time: " + str(dt * 1000.0) + " ms");
