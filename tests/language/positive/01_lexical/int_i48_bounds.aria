// 钉住：int 为 i48，正负边界字面量与边界内算术合法；越界见 integer_overflow 语料。
var max = 140737488355327;      // 2^47 - 1
assert(max == 140737488355327);
assert(max - 1 == 140737488355326);
assert(max / 2 == 70368744177663);
var min = -140737488355327 - 1; // -2^47，经算术到达
assert(min + 1 == -140737488355327);
assert(min / 2 == -70368744177664); // 向零截断
