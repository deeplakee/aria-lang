// 钉住：用户类以 dunder 方法名定义运算符重载（名字见 src/runtime/str_table.hpp 的注册表），算子运行期按名
// 到对象上取实现并调用--类链继承、实例字段遮蔽、显式按名调用三条一起钉。
def Box {
  init(v) { this.v = v; }
  __add__(o) { return Box(this.v + o.v); }
  __lt__(o) { return this.v < o.v; }
  __ge__(o) { return this.v >= o.v; }
  __neg__() { return Box(0 - this.v); }
}
var a = Box(1);
var b = Box(2);

// 二元（算术/比较）与一元算子都经钩子调用，钩子的返回值就是算子结果（不做类型强转）
assert((a + b).v == 3);
assert(a < b);
assert(b >= a);
assert((-a).v == -1);

// 类链继承：子类没自有钩子，沿类链取父类的
def Sub : Box {
  init(v) { super.init(v); }
}
assert((Sub(5) + Box(1)).v == 6);
assert(Sub(5) < Box(9));

// 实例字段遮蔽类链钩子：字段里的函数值原值直调（非方法戳，收实参不收 this）
var c = Box(10);
c.__add__ = fun(o) { return o.v; };
assert(c + Box(7) == 7);

// 钩子就是普通方法：能读、能显式按名调用（实例侧读出绑定方法，类表侧读出裸原生）
assert(a.__add__(b).v == 3);
assert("ab".__add__("c") == "abc");
assert(type(c.__add__) == "Closure");
