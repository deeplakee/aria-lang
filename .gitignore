# CMake 构建目录（build*/ 覆盖 build/、build-release/ 等多构建目录；cmake-build-* 为 IDE）
/build*/
/cmake-build-*/

# IDE
/.idea/
/.vscode/
/.vs/
CMakeSettings.json
.cache/

# 编译产物
*.o
*.obj
*.exe
*.lib
*.dll
*.pdb

# OS
.DS_Store

# 本地分析报告（local- 前缀的 markdown = 本机生成产物，不入库）
local-*.md

# Python 字节码（bench 驱动）
__pycache__/

# Claude Code 本地配置（项目文档 .claude/rules / reference / plans 入库）
.claude/settings.local.json
.claude/.local/

.zcode/plans/