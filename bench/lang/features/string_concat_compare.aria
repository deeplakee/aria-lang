// 量字符串拼接与比较算子:每轮三处 `+` 拼接 + `==` 内容判等 + 两个字序比较(按无符号字节序)。
var rounds = 2000000;  // 规模

var t0 = clock();
var acc = 0;
var i = 0;
while (i < rounds) {
    var s = "abc" + "def" + "ghi";
    if (s == "abcdefghi") {
        acc = acc + 1;
    }
    if (s < "abz") {
        acc = acc + 2;
    }
    if (s >= "abcdefgh") {
        acc = acc + 3;
    }
    acc = (acc + (s + "!").size()) % 1000003;
    i += 1;
}
var dt = clock() - t0;

assert(acc == 999907);
println("value checksum: " + str(acc));
println("bench-time: " + str(dt * 1000.0) + " ms");
