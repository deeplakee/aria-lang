// 量用户类算子重载:每轮 `a + b` 走 ADD -> 按名取实现 -> 调用,与内置数值路径对照。
var iterations = 4000000; // 规模

def Box {
    init(v) {
        this.v = v;
    }
    __add__(other) {
        return this.v + other.v;
    }
}

var a = Box(3);
var b = Box(4);

var t0 = clock();
var acc = 0;
var i = 0;
while (i < iterations) {
    acc = (acc + (a + b)) % 1000003;
    i += 1;
}
var dt = clock() - t0;

assert(acc == 999919);
println("value checksum: " + str(acc));
println("bench-time: " + str(dt * 1000.0) + " ms");
