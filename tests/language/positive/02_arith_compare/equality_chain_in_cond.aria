// 钉 || 链内 == 判等与外层条件跳转的关系:链的中间结果才是跳转条件,链内判等不得被
// 外层融合吞掉(误融合会双弹操作数并覆盖 || 已回填的链尾补丁地址,直接栈错/跳错)。
var hits = 0;
var s = "b";
if (s == "a" || s == "b") {
    hits += 1;
}
if (s == "x" || s == "y") {
    hits += 10;
}
if (s == "a" || s == "c" || s == "d" || s == "e") {
    hits += 100;
}
if (s == "b" && s != "z") {
    hits += 1000;
}
var n = 3;
if (n == 1 || n == 3) {
    hits += 10000;
}
assert(hits == 11001);
