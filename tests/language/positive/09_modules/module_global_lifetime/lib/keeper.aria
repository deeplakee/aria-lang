// 辅助模块：模块顶层 var 为模块全局，模块体内多个函数共享读写同一份；
# 体跑完前的全部断言即对模块全局生命周期的自检，主模块另经 K1.count/K1.bump() 跨模块
# 钉住「成员读的就是这份全局」（见 main.aria）。
var count = 0;
fun bump() {
    count += 1;
    return count;
}
fun peek_times10() {
    return count * 10;
}
assert(bump() == 1);
assert(bump() == 2);
assert(count == 2);
assert(peek_times10() == 20);
count = 5;                 # 顶层直接写
assert(peek_times10() == 50);
fun make_inc_closure() {
    return fun() {
        count += 1;        # 闭包穿透到模块全局
        return count;
    };
}
var inc = make_inc_closure();
assert(inc() == 6);
assert(inc() == 7);
assert(count == 7);
print("keeper ok");
