// 真实负载:文档版本 diff -- LCG 造基准文档,按比例做替换/插词/删词得修订版,再对每对版本跑
// LCS 全表动态规划 + 回溯,统计保留/删除/插入词数(评审工具的词级 diff)。规模见 doc_size/pairs。
var doc_size = 130;  // 规模:文档词数
var pairs = 42;      // 规模:版本对数

var vocab = ["alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta", "iota", "kappa",
             "lambda", "mu"];

var state = 555;
fun rnd(n) {
    state = (state * 48271) % 2147483647;
    return state % n;
}

fun gen_doc() {
    var d = [];
    var i = 0;
    while (i < doc_size) {
        d.push(vocab[rnd(vocab.size())]);
        i += 1;
    }
    return d;
}

fun mutate(src) {
    var out = [];
    var i = 0;
    while (i < src.size()) {
        var roll = rnd(20);
        if (roll == 0) {
            // 删词:跳过
        } else if (roll == 1) {
            out.push(vocab[rnd(vocab.size())]);
        } else if (roll == 2) {
            out.push(src[i]);
            out.push(vocab[rnd(vocab.size())]);
        } else {
            out.push(src[i]);
        }
        i += 1;
    }
    return out;
}

fun diff_counts(a, b) {
    var n1 = a.size();
    var n2 = b.size();
    var t = [];
    var i = 0;
    while (i <= n1) {
        var row = [];
        var j = 0;
        while (j <= n2) {
            row.push(0);
            j += 1;
        }
        t.push(row);
        i += 1;
    }
    i = 1;
    while (i <= n1) {
        var j = 1;
        while (j <= n2) {
            if (a[i - 1] == b[j - 1]) {
                t[i][j] = t[i - 1][j - 1] + 1;
            } else {
                var up = t[i - 1][j];
                var left = t[i][j - 1];
                if (up >= left) {
                    t[i][j] = up;
                } else {
                    t[i][j] = left;
                }
            }
            j += 1;
        }
        i += 1;
    }
    var eq = 0;
    var del = 0;
    var ins = 0;
    i = n1;
    var j = n2;
    while (i > 0 && j > 0) {
        if (a[i - 1] == b[j - 1]) {
            eq += 1;
            i -= 1;
            j -= 1;
        } else if (t[i - 1][j] >= t[i][j - 1]) {
            del += 1;
            i -= 1;
        } else {
            ins += 1;
            j -= 1;
        }
    }
    del += i;
    ins += j;
    return [eq, del, ins];
}

var t0 = clock();
var eq_sum = 0;
var del_sum = 0;
var ins_sum = 0;
var p = 0;
while (p < pairs) {
    var a = gen_doc();
    var b = mutate(a);
    var [eq, del, ins] = diff_counts(a, b);
    eq_sum = (eq_sum + eq) % 1000003;
    del_sum = (del_sum + del) % 1000003;
    ins_sum = (ins_sum + ins) % 1000003;
    p += 1;
}
assert(eq_sum == 4966);
assert(del_sum == 494);
assert(ins_sum == 503);

var dt = clock() - t0;
println("value eq_sum: " + str(eq_sum));
println("value del_sum: " + str(del_sum));
println("value ins_sum: " + str(ins_sum));
println("bench-time: " + str(dt * 1000.0) + " ms");
