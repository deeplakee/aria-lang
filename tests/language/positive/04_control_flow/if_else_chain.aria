// 钉住：if/else if/else 链与真值判定（仅 nil/false 为假）。
fun grade(n) {
    if (n >= 90) {
        return "A";
    } else if (n >= 80) {
        return "B";
    } else if (n >= 70) {
        return "C";
    } else {
        return "F";
    }
}
assert(grade(95) == "A");
assert(grade(90) == "A");
assert(grade(85) == "B");
assert(grade(70) == "C");
assert(grade(69) == "F");
# 真值：0 与 "" 为真
var hits = 0;
if (0) { hits += 1; }
if ("") { hits += 2; }
if (nil) { hits += 100; }
if (false) { hits += 1000; }
assert(hits == 3);
# 无 else 的 if
var flagged = false;
if (hits == 3) { flagged = true; }
assert(flagged);
