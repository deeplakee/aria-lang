// 钉住：print 字符串不带引号原样输出；转义序列已解码；\u{...} 输出真实 UTF-8；
# 空串输出空行；配同名 .out 逐字节比对。
print("hello");
print('single');
print("with\ttab");
print("with\nnewline");
print("");
print("\u{1F600}");
print("\u{4e2d}\u{6587}");
print("héllo");
print(str(42));          # str(Int) 转 String 后同样裸输出
print(str(nil));
print(str(true));
