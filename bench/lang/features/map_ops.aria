// 量 map 增删查:建表(下标写)后每轮 has + get 两次查表(键判等走 ===)。
var entries = 100000;  // 表长
var rounds = 40;       // 规模:整表查询轮数

var m = {};
var i = 0;
while (i < entries) {
    m[i] = i * 2;
    i += 1;
}

var t0 = clock();
var acc = 0;
var r = 0;
while (r < rounds) {
    var j = 0;
    while (j < entries) {
        if (m.has(j)) {
            acc = (acc + m.get(j)) % 1000003;
        }
        j += 1;
    }
    r += 1;
}
acc = (acc + m.size()) % 1000003;
var dt = clock() - t0;

assert(acc == 900018);
println("value checksum: " + str(acc));
println("bench-time: " + str(dt * 1000.0) + " ms");
