// 钉住：remove/remove_at——remove_at(i) 按位置移除并返回（负数从尾计数、与下标读写
# 同语义）；remove(x) 移除**全部** == 命中元素（保序，只要一处用 find + remove_at 组合），
# 命中 true 未命中 false（miss 走返回值，与 find 返 nil / contains 返 false 同族，不占
# 错误通道）。remove_at 越界见 negative/runtime_errors/runtime_list_remove_at_out_of_range。
var xs = [1, 2, 3];
assert(xs.remove_at(0) == 1);       // 头部出队
assert(xs == [2, 3]);
assert(xs.remove_at(-1) == 3);      // 负数从尾计数，等价 pop()
assert(xs == [2]);
assert(xs.remove_at(0) == 2 && len(xs) == 0);

// remove：全部 == 命中元素被移除，剩余保序
var ys = [1, 2, 1];
assert(ys.remove(1));               // 命中返 true
assert(ys == [2]);
assert(!ys.remove(9));              // 未命中返 false，不报错
assert(ys == [2]);

var many = [1, 2, 1, 3, 1];
assert(many.remove(1));
assert(many == [2, 3]);

// nil 与嵌套容器按内容判定（== 语义）
var zs = [1, nil, [2], nil];
assert(zs.remove(nil));
assert(zs.remove([2]));
assert(zs == [1]);

// 空表
var empty = [];
assert(!empty.remove(0));
