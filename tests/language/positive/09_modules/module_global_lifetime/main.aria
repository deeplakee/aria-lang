// 钉住：模块全局生命周期--辅助模块体的函数/闭包共享其模块全局（lib/keeper 内部断言）；
# 跨模块访问同一份：K1/K2 是同一模块对象（=== 同指针）、成员读到的 count 一致，且
# 经 K1.bump() 自增后 K2.count 同步可见（同一份全局，非拷贝）；
# 再次导入（带 .aria 后缀写法）复用已加载模块，体不重跑（"keeper ok" 只出现一次）；
# 配 .out golden。
import "./lib/keeper" as K1;
import "./lib/keeper.aria" as K2;
assert(K1 === K2);          // 两种 specifier 归一到同一模块对象
assert(K1.count == 7);      // 体跑完时的值（keeper 内部自检一路写到 7）
assert(K2.count == 7);
assert(K1.bump() == 8);     // 跨模块调用：写的是同一份模块全局
assert(K2.count == 8);
println("main done");
