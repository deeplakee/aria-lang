// 钉住：while 循环与 break/continue。
var i = 0;
var acc = 0;
while (i < 10) {
    i += 1;
    if (i % 2 == 0) {
        continue;       // 跳过偶数
    }
    if (i > 7) {
        break;          // 9 时中断
    }
    acc += i;
}
assert(i == 9);
assert(acc == 1 + 3 + 5 + 7);
var n = 5;
var fact = 1;
while (n > 1) {
    fact *= n;
    n -= 1;
}
assert(fact == 120);
var never = 0;
while (false) {
    never += 1;         # 零次迭代
}
assert(never == 0);
