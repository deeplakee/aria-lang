// 量解构与切片:每轮一次列表解构绑定 + 一次 range 切片(切片每轮铸一个新 list,故兼压 GC)。
var iterations = 2000000;  // 规模

var pair = [1, 2];
var xs = [10, 20, 30, 40, 50];

var t0 = clock();
var acc = 0;
var i = 0;
while (i < iterations) {
    var [a, b] = pair;
    var head = xs[1..4];
    var [x, y] = head;
    acc = (acc + a + b + x + y) % 1000003;
    i += 1;
}
var dt = clock() - t0;

assert(acc == 999685);
println("value checksum: " + str(acc));
println("bench-time: " + str(dt * 1000.0) + " ms");
