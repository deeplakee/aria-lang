// 综合：循环内 per-iteration try/catch--奇数累加、偶数经 throw 通道走补偿分支；
# 验证每轮 catch 状态独立、循环不被异常中断。
var total = 0;
for (var i = 1; i <= 6; i += 1) {
    try {
        if (i % 2 == 0) {
            throw i;
        }
        total += i;          # 奇数：正常累加
    } catch (e) {
        total += 100;        # 偶数：补偿
    }
}
assert(total == 1 + 3 + 5 + 300);
# 异常打断循环 + 外部恢复后继续下一轮循环
var done = 0;
var passes = 0;
while (done < 3) {
    done += 1;
    try {
        if (done < 3) {
            throw "skip";
        }
        passes += 1;
    } catch (e) {
        assert(e == "skip");
    }
}
assert(done == 3);
assert(passes == 1);         # 只有第 3 轮走完正常路径
