// 标量数学函数的类型、取整边界、角度单位与特殊浮点值。
import "std:math" as math;

fun assert_near(actual, expected) {
    assert(type(actual) == "F64");
    assert(math.abs(actual - expected) < 1e-12);
}

assert(math.tau === 2 * math.pi);
assert(math.inf === 1.0 / 0.0);
assert(type(math.nan) == "F64");
assert(math.is_nan(math.nan));
assert(math.is_inf(math.inf) === true);
assert(math.is_inf(-math.inf));
assert(!math.is_inf(math.nan));
assert(!math.is_inf(1));
assert(!math.is_inf(1.5));

assert(math.trunc(2.75) === 2.0);
assert(math.trunc(-2.75) === -2.0);
assert(math.trunc(-0.25) === -0.0);
assert(math.round(2) === 2.0);
assert(math.round(2.5) === 3.0);
assert(math.round(-2.5) === -3.0);
assert(math.round(-2.4) === -2.0);
assert(math.round(-0.25) === -0.0);
assert(math.round(1e20) === 1e20);
assert(math.round(math.inf) === math.inf);
assert(math.is_nan(math.trunc(math.nan)));

assert_near(math.cbrt(-27), -3.0);
assert_near(math.pow(2, 5), 32.0);
assert_near(math.pow(9, 0.5), 3.0);
assert(math.is_nan(math.pow(-1, 0.5)));
assert_near(math.hypot(3, -4), 5.0);
assert_near(math.hypot(3e200, 4e200) / 1e200, 5.0);
assert_near(math.hypot(3e-200, 4e-200) / 1e-200, 5.0);
assert_near(math.exp(1), math.e);
assert_near(math.log(math.e), 1.0);
assert_near(math.log2(8), 3.0);
assert_near(math.log10(100), 2.0);
assert(math.log(0) === -math.inf);
assert(math.is_nan(math.log(-1)));

assert_near(math.sin(math.pi / 2), 1.0);
assert_near(math.cos(math.pi), -1.0);
assert_near(math.tan(math.pi / 4), 1.0);
assert_near(math.asin(1), math.pi / 2);
assert_near(math.acos(-1), math.pi);
assert_near(math.atan(1), math.pi / 4);
assert_near(math.atan2(1, -1), 3 * math.pi / 4);
assert_near(math.atan2(-1, 1), -math.pi / 4);
assert(math.is_nan(math.asin(2)));
assert(math.is_nan(math.acos(-2)));
