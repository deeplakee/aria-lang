# CMake 构建目录（build*/ 覆盖 build/、build-release/ 等多构建目录；cmake-build-* 为 IDE）
/build*/
/cmake-build-*/

# IDE
/.idea/
/.vscode/
/.vs/
CMakeSettings.json
.cache/

# 编译产物
*.o
*.obj
*.exe
*.lib
*.dll
*.pdb

# OS
.DS_Store

# 本地分析报告（local- 前缀的 markdown = 本机生成产物，不入库）
local-*.md

# Python 字节码（bench 驱动）
__pycache__/

# 本地 agent 工具目录（真源住 .agents/，各开发者按自己用的 agent 本地自建软链）
/.claude/
/.zcode/
/.zcodeignore

# Codex CLI 本地配置（指向本机 CLion MCP 端口，机器相关）
/.codex/