// 真实负载:Brainfuck 解释器 -- 预处理(剔注释字符 + 括号配对表)后,字符级取指、纸带读写、
// 循环跳转地解释执行一组 LCG 造的乘法打印程序;套件先逐程序按封闭式期望值对答案自校验,
// 再进重复执行段。规模见 suite_n/rounds。
var suite_n = 24;   // 规模:生成程序数
var rounds = 70;    // 规模:执行轮数

var state = 91;
fun rnd(n) {
    state = (state * 48271) % 2147483647;
    return state % n;
}

fun preprocess(src) {
    var code = [];
    var jumps = {};
    var stack = [];
    var i = 0;
    while (i < src.size()) {
        var c = src[i];
        if (c == "+" || c == "-" || c == "<" || c == ">" || c == "." || c == "," || c == "[" || c == "]") {
            if (c == "[") {
                stack.push(code.size());
            } else if (c == "]") {
                if (stack.size() == 0) {
                    throw "bf: unmatched ]";
                }
                var open = stack.pop();
                jumps[open] = code.size();
                jumps[code.size()] = open;
            }
            code.push(c);
        }
        i += 1;
    }
    if (stack.size() != 0) {
        throw "bf: unmatched [";
    }
    return [code, jumps];
}

fun run_bf(code, jumps) {
    var tape = [];
    var t = 0;
    while (t < 64) {
        tape.push(0);
        t += 1;
    }
    var out = 0;
    var dp = 0;
    var pc = 0;
    var n = code.size();
    while (pc < n) {
        var c = code[pc];
        if (c == "-") {
            tape[dp] -= 1;
        } else if (c == "+") {
            tape[dp] += 1;
        } else if (c == "<") {
            dp -= 1;
        } else if (c == ">") {
            dp += 1;
        } else if (c == "[") {
            if (tape[dp] == 0) {
                pc = jumps.get(pc);
            }
        } else if (c == "]") {
            // 回跳后让公共的 pc += 1 恰好落在配对 [ 上重新判零
            pc = jumps.get(pc) - 1;
        } else if (c == ".") {
            out += tape[dp];
        }
        pc += 1;
    }
    return out;
}

// 乘法打印程序:cell0 = a,cell1 累加出 a*b 后逐次递减打印([.-] 输出 a*b..1 的码点)。
// 期望码点和 = a*b*(a*b+1)/2,封闭式自校验。
fun make_mul_prog(a, b) {
    var p = "";
    var j = 0;
    while (j < a) {
        p += "+";
        j += 1;
    }
    p += "[>";
    j = 0;
    while (j < b) {
        p += "+";
        j += 1;
    }
    p += "<-]>";
    p += "[.-]";
    return p;
}

var sources = [];
var expected = [];
var i = 0;
while (i < suite_n) {
    var a = 4 + rnd(16);
    var b = 4 + rnd(16);
    sources.push(make_mul_prog(a, b));
    expected.push(a * b * (a * b + 1) / 2);
    i += 1;
}

var compiled = [];
i = 0;
while (i < sources.size()) {
    var cm = preprocess(sources[i]);
    if (run_bf(cm[0], cm[1]) != expected[i]) {
        throw "bf: suite self-check failed";
    }
    compiled.push(cm);
    i += 1;
}

var t0 = clock();
var total = 0;
var r = 0;
while (r < rounds) {
    for (cm in compiled) {
        total = (total + run_bf(cm[0], cm[1])) % 1000003;
    }
    r += 1;
}
assert(total == 632355);

var dt = clock() - t0;
println("value checksum: " + str(total));
println("bench-time: " + str(dt * 1000.0) + " ms");
