# 钉住：外部 is_a 按真实所属类链判定，类对象身份与模板继承关系分开。
def Base : Exception {
}
def Derived : Base {
}
def Unrelated {
}

# 实例接收者：沿自身类链向上命中即 true
var d = Derived();
assert(is_a(d, Derived));
assert(is_a(d, Base));
assert(is_a(d, Exception));
var b = Base();
assert(is_a(b, Base));
assert(is_a(b, Exception));
assert(!is_a(b, Derived));        # 父类实例不命中子类
var u = Unrelated();
assert(is_a(u, Unrelated));
assert(!is_a(u, Exception));      # Object 根下与 Exception 平行的分支不串
assert(!is_a(u, Base));

# 异常接收者：链根 = Exception bootstrap 类
try {
    var x = 1 / 0;
} catch (e) {
    assert(is_a(e, Exception));
    assert(!is_a(e, Base));
    assert(!is_a(e, Derived));
}
var err = Error("x");
assert(is_a(err, Exception));
assert(!is_a(err, Base));

# 类接收者：链根 = Class 元类单例（类值的归属链）
assert(is_a(Derived, Class));
assert(is_a(Base, Class));
assert(is_a(Object, Class));
assert(is_a(Class, Class));
assert(is_a(Derived, Object));    # 元类链沿至根
assert(!is_a(Derived, Base));     # 模板继承链不参与类值判定
assert(!is_a(Base, Exception));

# 内置容器/迭代器：解析委托各自 bootstrap 类，沿链走（对 Exception 目标恒 miss）
assert(!is_a([], Exception));
assert(!is_a("s", Base));
assert(!is_a({}, Exception));
assert(!is_a((1..2), Base));
assert(!is_a([].iter(), Exception));

# 内置类裸名曝光：内置值对内置类与根类的归属判定
assert(is_a([1, 2], List));
assert(is_a("s", String));
assert(is_a({}, Map));
assert(is_a((1..2), Range));
assert(is_a([].iter(), Iterator));
assert(is_a([1, 2], Object));     # 任意对象沿链命中根
assert(is_a(Object, Object));     # 元类链沿至根类，根类命中自身名下

# fn 族/协程单例腿：咨询归属链 = 各自 bootstrap 单例类
var fn = fun(a) { return a; };
assert(is_a(fn, Function));
assert(is_a(fn, Object));
assert(is_a(println, Function));
assert(is_a(Coroutine.create(fun() { yield; }), Coroutine));
