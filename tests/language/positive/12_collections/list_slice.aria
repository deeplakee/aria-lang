// 钉住：list 切片——range 作下标键产出新 list；a..b 闭区间 / a...b 半开 / a.. 无上界；
# 端点从尾计数（负端点）；空 range（a...a）产空 list；切片可再迭代/再取 len；切片只读。
var xs = [10, 20, 30, 40, 50];

var s1 = xs[1..3];
assert(s1 == [20, 30, 40]);
assert(s1 == xs[1...4]);

var s2 = xs[1...3];
assert(s2 == [20, 30]);

var s3 = xs[3..];
assert(s3 == [40, 50]);
assert(xs[0..] == xs);

// 负端点从尾计数（与单下标同约定）
assert(xs[-3..] == [30, 40, 50]);
assert(xs[-1..] == [50]);
assert(xs[-3..-1] == [30, 40, 50]);

// 正起点配负终点（方向按归一化端点判，不误报倒序）
assert(xs[1..-1] == [20, 30, 40, 50]);
assert(xs[0..-1] == xs);
assert(xs[1...-1] == [20, 30, 40]);

// 空 range（a...a）产空 list；单元素切片
assert(xs[2...2] == []);
assert(xs[2..2] == [30]);

// 切片结果可再消费
var t = 0;
for (x in xs[-2..]) { t = t + x; }
assert(t == 90);
assert(len(xs[0..2]) == 3);

// 原表不变（切片是新 list）
assert(xs == [10, 20, 30, 40, 50]);
