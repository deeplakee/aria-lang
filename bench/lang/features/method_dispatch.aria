// 量实例方法调用:每轮 PREPARE_METHOD(类链查表、不绑定)+ CALL_METHOD 两段派发。
var iterations = 5000000; // 规模

def Counter {
    init() {
        this.base = 1;
    }
    step(delta) {
        return this.base + delta;
    }
}

var counter = Counter();

var t0 = clock();
var acc = 0;
var i = 0;
while (i < iterations) {
    acc = (acc + counter.step(i)) % 1000003;
    i += 1;
}
var dt = clock() - t0;

assert(acc == 105);
println("value checksum: " + str(acc));
println("bench-time: " + str(dt * 1000.0) + " ms");
