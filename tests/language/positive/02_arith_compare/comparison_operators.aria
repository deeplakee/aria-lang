// 钉住：比较 > >= < <=（仅数值，含 Int/F64 混合）。真值 Lua 风格（仅 nil/false 为假）。
assert(1 < 2);
assert(2 <= 2);
assert(3 > 2);
assert(3 >= 3);
assert(1.5 < 2);
assert(2 < 2.5);
assert(2.0 <= 2);   // 跨类型数值比较
assert(2 >= 2.0);
assert(!(1 > 2));
assert(1 < 2 && 2 < 3);
// 注意：比较是左结合的，`3 > 2 > 1` 会按 `(3>2) > 1` 即 Bool > Int 报错；
// 链式区间判断须显式用 && 连接（本脚本只钉正确的写法）。
assert(1 < 2 && 2 < 3 && 3 < 4);
assert(-1.5 < -1 && -1 < 0);
