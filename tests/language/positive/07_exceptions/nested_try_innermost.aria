// 钉住：嵌套 try 取最内层匹配 handler；内外各自捕获互不越界。
try {
    try {
        throw "inner";
    } catch (e) {
        assert(e == "inner");
        throw "from-catch";   # catch 内再抛，由外层接住
    }
} catch (e2) {
    assert(e2 == "from-catch");
}
# 内层不抛则外层 handler 不触发
var outer_hits = 0;
try {
    try {
        var ok = 1;
    } catch (inner_e) {
        assert(false);    # 不可达：内层无异常
    }
} catch (e) {
    outer_hits += 1;
}
assert(outer_hits == 0);
# 同层顺序 try 各自独立
try {
    throw "a";
} catch (e) {
    assert(e == "a");
}
try {
    throw "b";
} catch (e) {
    assert(e == "b");
}
