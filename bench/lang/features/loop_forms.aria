// 量循环形态:C 风格 for 的初始化/条件/步进 + continue/break 的回填跳转。
var rounds = 500000;  // 规模

var t0 = clock();
var acc = 0;
var r = 0;
while (r < rounds) {
    for (var k = 0; k < 16; k += 1) {
        if (k % 3 == 0) {
            continue;
        }
        if (k > 12) {
            break;
        }
        acc = (acc + k) % 1000003;
    }
    r += 1;
}
var dt = clock() - t0;

assert(acc == 999931);
println("value checksum: " + str(acc));
println("bench-time: " + str(dt * 1000.0) + " ms");
