// 钉住：嵌套两级 resume——协程内创建并 resume 另一协程，各自独立往返；嵌套实参位
// （resume 的载荷表达式内含另一个 yield 所在上下文的值）不互相干扰。
fun inner(k) {
    var got = Coroutine.yield(k * 100);
    return got + 7;
}
fun outer() {
    var ic = Coroutine.create(inner);
    var first = Coroutine.resume(ic, 3);
    Coroutine.yield(first + 1);
    return Coroutine.resume(ic, 4);
}
var oc = Coroutine.create(outer);
assert(Coroutine.resume(oc) == 301);
assert(Coroutine.status(oc) == "suspended");
assert(Coroutine.resume(oc) == 11);
assert(Coroutine.status(oc) == "done");
