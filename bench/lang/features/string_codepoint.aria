// 量码点域:每轮一次 chars()(按码点切出列表)+ 两次 codepoint_at + 首个字符的码点。
// 校验和只收码点域读数:字节域 size() 各语言口径不同(UTF-8 字节 / UTF-16 单元),不进校验和。
var rounds = 1100000;  // 规模

var base = "héllo wörld";

var t0 = clock();
var acc = 0;
var i = 0;
while (i < rounds) {
    var cs = base.chars();
    acc = (acc + cs.size() + base.codepoint_at(1) + base.codepoint_at(4) +
           cs[0].codepoint_at(0)) % 1000003;
    i += 1;
}
var dt = clock() - t0;

assert(acc == 898488);
assert(base.chars().size() == 11);
println("value checksum: " + str(acc));
println("value codepoints: " + str(base.chars().size()));
println("bench-time: " + str(dt * 1000.0) + " ms");
