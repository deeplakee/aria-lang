// 钉住：println--渲染走 format_value 加换行、0/1 参、返 nil、可作一等值传参。
println(42);
println(-7);
println(0);
println("raw");
println(nil);
println(true);
println(false);
println(1.5);
println(3.0);            # 渲染经 format_value：保 .0
println([1, "two", nil]);
println({"k": 1});

# 无参：只输出一个换行（下列三行各产一个空行）
println();
println();
assert(println() == nil); # 0 参同样返 nil

# 返 nil：结果可参与表达式（作语句时被 POP 丢弃）
assert(println("ret") == nil);
assert(type(println) == "NativeFn");

# 一等值：可作实参传入、经形参调用
fun twice(f, x) {
    f(x);
    f(x);
}
twice(println, "twice");

# 元数自检：多于 1 参抛 WrongArity，可 catch
try {
    println(1, 2);
} catch (e) {
    assert(type(e) == "Exception");
}
