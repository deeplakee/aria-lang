// 钉住：int 除法向零截断、模随被除数符号（同 C 语义）。-7/2 == -3（非 -4）。
assert(7 / 2 == 3);
assert(-7 / 2 == -3);
assert(7 / -2 == -3);
assert(-7 / -2 == 3);
assert(-7 % 3 == -1);
assert(7 % -3 == 1);
assert(-7 % -3 == -1);
assert(7 % 3 == 1);
assert(0 / 5 == 0);
assert(0 % 5 == 0);
assert((7 / 2) * 2 + 7 % 2 == 7); // 商余恒等式
