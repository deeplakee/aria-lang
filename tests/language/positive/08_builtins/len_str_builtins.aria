// 钉住：len（接受 String/List/Map；String 返 UTF-8 字节数）与 str（任意值转 String）。
assert(len("abc") == 3);
assert(len("") == 0);
assert(len("中文") == 6);
assert(str(42) == "42");
assert(str(-7) == "-7");
assert(str(nil) == "nil");
assert(str(true) == "true");
assert(str(false) == "false");
assert(str("raw") == "raw");
assert(str(1.5) == "1.5");
assert(str(3.0) == "3.0");            # 与 print 同款渲染：保 .0
assert(str(len("abc")) == "3");       # 组合：len -> Int -> str
# str 结果是普通字符串：可 == 比较、可作 len 输入
assert(len(str(140737488355327)) == 15);
assert(str(1 == 1.0) == "true");
