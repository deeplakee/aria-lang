// 量跨帧 unwind:异常在最内层抛出,两层中间帧不接,顶层 catch 收下(逐帧查异常记录表)。
var iterations = 2600000;  // 规模

fun level3(v) {
    throw v;
}

fun level2(v) {
    level3(v);
    return -1;
}

fun level1(v) {
    level2(v);
    return -1;
}

var t0 = clock();
var acc = 0;
var i = 0;
while (i < iterations) {
    try {
        level1(i);
    } catch (e) {
        acc = (acc + e) % 1000003;
    }
    i += 1;
}
var dt = clock() - t0;

assert(acc == 560036);
println("value checksum: " + str(acc));
println("bench-time: " + str(dt * 1000.0) + " ms");
