// 钉住：迭代协议对用户类开放（结构性三方法 iter/has_next/next，编译器零魔法）；
# 用户类实现协议即可被 for-in 遍历，与内置 list 走同一降糖路径。
def Countdown {
    init(from) { this.cur = from; }
    iter() { return this; }
    has_next() { return this.cur > 0; }
    next() {
        this.cur -= 1;
        return this.cur + 1;
    }
}
var acc = 0;
for (v in Countdown(4)) { acc += v; }
assert(acc == 4 + 3 + 2 + 1);

// iter 返回 this 的形态：实例自身即迭代器，游标在实例上（遍历即耗尽，重遍须新实例）
var cd = Countdown(2);
var first = 0;
for (v in cd) { first = first * 10 + v; }
assert(first == 21);
var cd2 = Countdown(2);
var second = 0;
for (v in cd2) { second = second * 10 + v; }
assert(second == 21);

// 独立迭代器类：iter() 返回专职对象（协议不要求返回 this）
def Range10 {
    init() { this.n = 0; }
    iter() { return Range10Iter(); }
}
def Range10Iter {
    init() { this.i = 1; }
    has_next() { return this.i <= 3; }
    next() {
        this.i += 1;
        return this.i - 1;
    }
}
var product = 1;
for (v in Range10()) { product *= v; }
assert(product == 6);

// 协议方法一等：it.next 经变量调用（方法表恒绑定，非虚函数特权）
var xs = [5, 6];
var it = xs.iter();
var next_fn = it.next;
assert(it.has_next());
assert(next_fn() == 5);
assert(next_fn() == 6);
assert(!it.has_next());
