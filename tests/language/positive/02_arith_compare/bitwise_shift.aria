// 钉住：移位语义——>> 算术保号（-1 不动点）、>>> 48 位无符号视图、<< 结果域检查的合法极值。
assert((1 << 0) == 1);
assert((1 << 46) == 70368744177664);
assert((-1 << 47) == -140737488355328);
assert((-16 >> 2) == -4);
assert((-1 >> 47) == -1);
assert((-1 >>> 1) == 140737488355327);
assert((-1 >>> 47) == 1);
assert((0xFF >>> 4) == 0x0F);
var x = -1;
var steps = 0;
while (x != 0) {
    x >>>= 1;
    steps += 1;
}
assert(steps == 48);
assert(x == 0);
