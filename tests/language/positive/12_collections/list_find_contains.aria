// 钉住：find/contains/size/is_empty--判定走 ==（value_equal 内容递归）、find 未命中
# 返 nil（下标永不为 nil，Ruby Array#index 同款--aria 有负下标，-1 是合法下标，
# miss 时 xs[find(x)] 会静默取末元素，Python str.find 的坑）、contains 即成员测试
#（list 无 in 表达式算子）、size/is_empty 为全局 len 的方法形态。
var xs = [1, nil, "a", [2]];
assert(xs.find(nil) == 1);          // nil 是合法元素，可查
assert(xs.find("a") == 2);
assert(xs.find([2]) == 3);          // 嵌套容器按内容相等
assert(xs.find(9) == nil);          // 未命中 nil

assert(xs.contains(nil));
assert(xs.contains([2]));
assert(!xs.contains(9));

// size/is_empty：元素数与空表谓词，与全局 len 一致
assert(xs.size() == 4);
assert(xs.size() == len(xs));
assert(!xs.is_empty());

var empty = [];
assert(empty.find(0) == nil);
assert(!empty.contains(0));
assert(empty.size() == 0);
assert(empty.is_empty());

// 首现位置
var ws = ["a", "b", "a"];
assert(ws.find("a") == 0);
assert(ws.find("c") == nil);