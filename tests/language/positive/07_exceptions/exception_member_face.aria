# 钉住：内建运行期错误的成员面——Exception bootstrap 类的 message()/code() 方法（经
# ObjException -> Exception 类表委托触达）；message() 返回完整烘焙消息，code() 返回错误码
# 数字（VM 报错 = ErrorCode 注册表序号，见 ARIA_ERROR_LIST 顺序）。
try {
    var x = 1 / 0;
    assert(false);       # 上一行必抛，不可达
} catch (e) {
    assert(type(e) == "Exception");
    assert(e.code() == 28);      # DivisionByZero
    assert(e.message() == "Runtime: DivisionByZero integer division by zero");
}
try {
    var x = nil + 1;
} catch (e) {
    assert(e.code() == 25);      # TypeMismatch
    assert(type(e.message()) == "String");
}
# message/code 是类表方法：可取出一等值再调用
try {
    var x = 1 % 0;
} catch (e) {
    var m = e.message;
    var c = e.code;
    assert(m() == "Runtime: ModuloByZero integer modulo by zero");
    assert(c() == 29);           # ModuloByZero
}
