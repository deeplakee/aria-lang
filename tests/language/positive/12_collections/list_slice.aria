// 钉住：list 切片——range 作下标键产出新 list；a..b 闭区间 / a...b 半开 / a.. 无上界；
# 端点从尾计数（负端点）；倒序 range（a>b）产出倒序段；空 range（a...a）产空 list；
# 切片可再迭代/再取 len；切片只读。
var xs = [10, 20, 30, 40, 50];

var s1 = xs[1..3];
assert(s1 == [20, 30, 40]);
assert(s1 == xs[1...4]);

var s2 = xs[1...3];
assert(s2 == [20, 30]);

var s3 = xs[3..];
assert(s3 == [40, 50]);
assert(xs[0..] == xs);

// 负端点从尾计数（与单下标同约定）
assert(xs[-3..] == [30, 40, 50]);
assert(xs[-1..] == [50]);
assert(xs[-3..-1] == [30, 40, 50]);

// 正起点配负终点（方向按归一化端点判，不误报倒序）
assert(xs[1..-1] == [20, 30, 40, 50]);
assert(xs[0..-1] == xs);
assert(xs[1...-1] == [20, 30, 40]);

// 倒序 range（a > b）产出倒序段，方向判据与 range 迭代一致
assert(xs[3..1] == [40, 30, 20]);
assert(xs[3...1] == [40, 30]);
assert(xs[4..0] == [50, 40, 30, 20, 10]);
assert(xs[2..0] == [30, 20, 10]);
assert(xs[-1..-3] == [50, 40, 30]);
assert(xs[-1...0] == [50, 40, 30, 20]);

// 空 range（a...a）产空 list；单元素切片
assert(xs[2...2] == []);
assert(xs[2..2] == [30]);

// 切片结果可再消费
var t = 0;
for (x in xs[-2..]) { t = t + x; }
assert(t == 90);
assert(len(xs[0..2]) == 3);

// 原表不变（切片是新 list）
assert(xs == [10, 20, 30, 40, 50]);

// 无上界形态 = 后缀语义：起点允许恰好等于长度（得空段），故「末尾之后取剩余」不报错
assert(xs[5..] == []);
assert(xs[5...] == []);
assert([][0..] == []);
assert([][0...] == []);
assert([7][1..] == []);
