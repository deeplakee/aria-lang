// 量短路逻辑:&& 与 || 的短路跳转(每轮两次比较 + 取模)。
var iterations = 6000000;  // 规模

var t0 = clock();
var acc = 0;
var i = 0;
while (i < iterations) {
    if (i > 0 && i % 2 == 0 || i % 7 == 0) {
        acc = acc + 1;
    }
    i += 1;
}
var dt = clock() - t0;

assert(acc == 3428571);
println("value checksum: " + str(acc));
println("bench-time: " + str(dt * 1000.0) + " ms");
