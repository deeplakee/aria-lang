// 真实负载:嵌套 list 的整数矩阵乘。量下标密度(每个内层步两次链式下标)与整数乘加。
var n = 250;  // 规模:矩阵边长

var t0 = clock();
var a = [];
var i = 0;
while (i < n) {
    var row = [];
    var j = 0;
    while (j < n) {
        row.push((i * 7 + j * 13 + 1) % 1009);
        j += 1;
    }
    a.push(row);
    i += 1;
}
var b = [];
i = 0;
while (i < n) {
    var row = [];
    var j = 0;
    while (j < n) {
        row.push((i * 11 + j * 3 + 2) % 1009);
        j += 1;
    }
    b.push(row);
    i += 1;
}

var checksum = 0;
i = 0;
while (i < n) {
    var j = 0;
    while (j < n) {
        var acc = 0;
        var k = 0;
        while (k < n) {
            acc += a[i][k] * b[k][j];
            k += 1;
        }
        checksum = (checksum * 31 + acc) % 1000000007;
        j += 1;
    }
    i += 1;
}
var dt = clock() - t0;
assert(checksum == 396310743);

println("value checksum: " + str(checksum));
println("bench-time: " + str(dt * 1000.0) + " ms");
