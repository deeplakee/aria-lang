// 钉住：位算子 & | ^ ~ 的真值与优先级实序（加减紧于移位、移位同层左结合、& 紧于 ^ 紧于 |）。
assert((5 & 3) == 1);
assert((5 | 3) == 7);
assert((5 ^ 3) == 6);
assert((0xF0 | 0x0F) == 0xFF);
assert((-1 & 0xFF) == 255);
assert(~0 == -1);
assert(~(-1) == 0);
assert(~5 == -6);
assert(~140737488355327 == -140737488355328);
assert((1 + 2 << 3) == 24);
assert((1 << 2 + 1) == 8);
assert((1 << 3 >> 1) == 4);
assert((1 | 2 ^ 3 & 4) == 3);
