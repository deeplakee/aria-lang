// 钉住：create 首启、yield 值往返、完成切回的返回值与 done 态（槽协议基础闭环）。
fun gen(n) {
    var x = Coroutine.yield(n + 1);
    return x * 2;
}
var g = Coroutine.create(gen);
assert(Coroutine.status(g) == "suspended");
assert(Coroutine.resume(g, 5) == 6);
assert(Coroutine.status(g) == "suspended");
assert(Coroutine.resume(g, 10) == 20);
assert(Coroutine.status(g) == "done");
