// 钉住：status 五态投影；running/normal 经首启载荷把协程对象自身传入查询（首启载荷即
// 被调函数实参），failed 经未捕获错误杀死后查询。
fun body(mirror) {
    assert(Coroutine.status(mirror) == "running");
    Coroutine.yield(1);
}
var c = Coroutine.create(body);
assert(Coroutine.status(c) == "suspended");
Coroutine.resume(c, c);

fun inner(mirror) {
    assert(Coroutine.status(mirror) == "normal");
    Coroutine.yield(9);
}
fun outer(mirror) {
    assert(Coroutine.status(mirror) == "running");
    var ic = Coroutine.create(inner);
    assert(Coroutine.resume(ic, mirror) == 9);
}
var oc = Coroutine.create(outer);
Coroutine.resume(oc, oc);
assert(Coroutine.status(oc) == "done");

fun fail_body(mirror) {
    assert(Coroutine.status(mirror) == "running");
    throw "x";
}
var fc = Coroutine.create(fail_body);
try {
    Coroutine.resume(fc, fc);
    assert(false);
} catch (e) {
}
assert(Coroutine.status(fc) == "failed");
