# CMake 构建目录（build*/ 覆盖 build/、build-release/ 等多构建目录；cmake-build-* 为 IDE）
/build*/
/cmake-build-*/

# IDE
/.idea/
/.vscode/
/.vs/
CMakeSettings.json
.cache/

# 编译产物
*.o
*.obj
*.exe
*.lib
*.dll
*.pdb

# OS
.DS_Store

# Claude Code 本地配置（项目文档 .claude/rules / reference / plans 入库）
.claude/settings.local.json
.claude/.local/

